# Copy this file to .env and fill in local values. Never commit real secrets.

PORT=8001
NODE_ENV=development
SECRET_KEY=change-me

# Optional JWT HMAC override. If unset, tokens are signed with SECRET_KEY (Django-compatible).
# JWT_SECRET=

# Existing Atlas cluster. Do not point this at a new database name.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=doctor_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://localhost:5173,https://127.0.0.1:5173,https://localhost:4173,https://127.0.0.1:4173
ALLOWED_HOSTS=localhost,127.0.0.1
# LAN IPs are added automatically in development (Vite 5173/5174 and preview 4173).
