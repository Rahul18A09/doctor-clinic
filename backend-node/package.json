{
  "name": "backend-node",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js Express TypeScript rewrite of the Django clinic backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ./src --include ./.env --exclude ./dist --exclude ./node_modules src/server.ts",
    "build": "tsc --pretty",
    "start": "node dist/server.js",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "read-user": "tsx src/scripts/read-existing-user.ts",
    "read-patient": "tsx src/scripts/read-existing-patient.ts",
    "clean-notifications": "tsx src/scripts/clean-internal-notifications.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
